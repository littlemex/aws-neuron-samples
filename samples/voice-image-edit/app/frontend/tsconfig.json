{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "ES2020"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    // file: dependencies (e.g. @aws-neuron-samples/neuron-anatomy) land in
    // node_modules/ as symlinks. Without preserveSymlinks, TypeScript
    // resolves the symlink to its real filesystem path and walks UP from
    // there to find node_modules/react -- but the real path is in another
    // sample directory with no node_modules at all, so react types become
    // unreachable. preserveSymlinks keeps resolution rooted at the symlink
    // location (this app's own node_modules), where react is installed.
    "preserveSymlinks": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
