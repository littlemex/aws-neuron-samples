# voice-image-edit deploy 既定値 (single source of truth)。
#
# deploy.sh の冒頭で source される。CLI フラグ ($1) と外部環境変数 ($2) と
# このファイル ($3) の優先順位は 1 → 2 → 3 (より明示的なものが勝つ)。
#
# 値を変更したいときの優先順:
#   1. `--bedrock-region us-west-2` のように deploy.sh のフラグで上書き
#   2. `BEDROCK_REGION=us-west-2 bash deploy.sh` のように env で上書き
#   3. このファイルを編集 (チーム共有の既定値変更)
#
# どの層も触らなければこのファイルの値が使われる。Python / task JSON / CDK の
# どこかで黙ってフォールバックされていた値はすべてここに集約し、二重管理を
# 排除する。新しい既定値を増やすときは必ずここに足してから deploy.sh が
# `${X:-${DEFAULT_X}}` で受ける形にする。

# -- AWS region / Bedrock 系 --------------------------------------------------
# DEFAULT_REGION は CLI 必須 (--region or AWS_REGION) なので default を持たない。
# 下記 3 つは Bedrock のモデルが提供されているリージョンが固定的に決まるため
# モデル単位で持つ。Stability SD3.5 は us-west-2 でしか提供されておらず、
# Polly Neural は sa-east-1 でまだ GA していない。
DEFAULT_BEDROCK_REGION=us-east-1
DEFAULT_GENERATE_BEDROCK_REGION=us-west-2
DEFAULT_EDIT_BEDROCK_REGION=us-west-2
DEFAULT_POLLY_REGION=us-east-1

# -- ALB ListenerRule priority -----------------------------------------------
# 100(api) < 150(stream) < 200(frontend) の順序を保つこと。逆転すると
# /api/edit/* リクエストが frontend rule にマッチして 404 を返す。
DEFAULT_API_RULE_PRIORITY=100
DEFAULT_STREAM_RULE_PRIORITY=150
DEFAULT_FRONTEND_RULE_PRIORITY=200

# -- Listen ports -------------------------------------------------------------
DEFAULT_API_PORT=8801
DEFAULT_STREAM_PORT=8800
DEFAULT_FRONTEND_PORT=3000

# -- Path patterns ------------------------------------------------------------
DEFAULT_API_PATH_PATTERN=/api/edit/*
DEFAULT_STREAM_PATH_PATTERN=/stream/*

# -- Origin verify -----------------------------------------------------------
DEFAULT_ORIGIN_VERIFY_HEADER=X-Origin-Verify

# -- Engine defaults ---------------------------------------------------------
# Default to the on-device Trainium serving (whisper / qwen3-vl /
# qwen-image-edit / xttsv2) — this is a Trainium demo, so the self-hosted
# models are the headline path. Bedrock engines remain selectable per request
# (and are the documented fallback). GENERATE has no Trainium implementation,
# so it stays on Stability.
DEFAULT_ASR_ENGINE=trainium
DEFAULT_VLM_ENGINE=trainium
DEFAULT_EDIT_ENGINE=trainium
DEFAULT_BEDROCK_ASR_BACKEND=transcribe

# -- Bedrock model IDs -------------------------------------------------------
# 各モデル ID はリージョンと密結合 (Stability は us-west-2 でしか動かない、
# Nova Canvas は LEGACY/us-east-1、Claude Opus 4.x は us-east-1 の
# cross-region inference profile 経由) なので DEFAULT_*_BEDROCK_REGION と
# セットで考えること。
# Claude Opus 4.5: 旧 claude-3-5-sonnet が Bedrock で EOL になったため置換。
# inference profile (us.anthropic.*) なので instance role は inference-profile
# ARN を許可している必要がある。
DEFAULT_BEDROCK_CLAUDE_OPUS_MODEL_ID=us.anthropic.claude-opus-4-5-20251101-v1:0
# Nova Canvas は EDIT スロット専用 (VLM ではない)。VLM の Bedrock は Claude Opus
# 1 本に集約したため Nova Pro / Lite の VLM 既定値は撤廃済み。
DEFAULT_BEDROCK_NOVA_CANVAS_MODEL_ID=amazon.nova-canvas-v1:0

# -- Trainium 自前サービング既定 --------------------------------------------
# URL は環境ごとに変わるので default を持たない。空 = trainium engine は
# config_missing で起動拒否される (engines/_common.env_required の挙動)。
DEFAULT_TRAINIUM_EDIT_MODEL_ID=Qwen/Qwen-Image-Edit-2511
